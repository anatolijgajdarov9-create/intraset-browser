{
  "name": "intra-browser",
  "version": "1.2.2",
  "description": "Intra — браузер для интранет сетей",
  "author": "Intra Browser Team",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite --port 3000\" \"wait-on tcp:3000 && electron --disable-gpu .\"",
    "build": "node scripts/setup-wincse.js && vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "electron": "electron --disable-gpu .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bonjour": "^3.5.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "express": "^4.22.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.14.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^9.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.0",
    "babel-jest": "^30.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "playwright": "^1.59.1",
    "rcedit": "^5.0.2",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.intra.browser",
    "productName": "Intra Browser",
    "icon": "intrabrowser-logo.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**",
      "main.js",
      "preload.js",
      "context-menu.html",
      "context-menu-preload.js",
      "debug-modal.html",
      "debug-modal-preload.js",
      "browser-preload.js",
      "package.json",
      "intrabrowser-logo.ico",
      "intrabrowser-logo.png",
      "intranet/src/**",
      "!intranet/src/data/**"
    ],
    "extraResources": [
      {
        "from": "llama server",
        "to": "llama server"
      },
      {
        "from": "intranet/bin",
        "to": "intranet/bin"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "intrabrowser-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "intrabrowser-logo.ico",
      "uninstallerIcon": "intrabrowser-logo.ico"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
