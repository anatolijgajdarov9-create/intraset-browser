{
  "expo": {
    "name": "Intra Browser",
    "slug": "intra-browser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./intrabrowsermobile-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./intrabrowsermobile-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intra.browser"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./intrabrowsermobile-logo.png",
        "backgroundColor": "#2563eb"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.intra.browser",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./intrabrowsermobile-logo.png"
    }
  }
}
